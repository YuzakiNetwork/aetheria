{
	"functions": {
		"api/**/*.js": {
			"maxDuration": 10
		}
	},
	"rewrites": [
		{
			"source": "/",
			"destination": "/api/home"
		},
		{
			"source": "/health",
			"destination": "/api/health"
		},
		{
			"source": "/dashboard",
			"destination": "/api/dashboard"
		},
		{
			"source": "/commands",
			"destination": "/api/commands"
		},
		{
			"source": "/changelog",
			"destination": "/api/changelog"
		},
		{
			"source": "/roadmap",
			"destination": "/api/roadmap"
		},
		{
			"source": "/support",
			"destination": "/api/support"
		},
		{
			"source": "/terms",
			"destination": "/api/legal-router?legalRoute=terms"
		},
		{
			"source": "/privacy",
			"destination": "/api/legal-router?legalRoute=privacy"
		},
		{
			"source": "/discord/linked-roles",
			"destination": "/api/legal-router?legalRoute=discord-linked-roles"
		},
		{
			"source": "/link",
			"destination": "/api/link"
		},
		{
			"source": "/link/callback",
			"destination": "/api/link"
		},
		{
			"source": "/api/link/complete",
			"destination": "/api/link-complete"
		},
		{
			"source": "/api/dashboard/me",
			"destination": "/api/dashboard-me"
		}
	]
}
